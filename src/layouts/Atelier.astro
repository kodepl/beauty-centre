---
import "../styles/global.css";
import site, { dzialSlug } from "../site.config";
const { title, description = site.tagline, image = site.heroImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ticker = [...site.ticker, ...site.ticker];
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(location.hostname.indexOf("www.")!==0 && location.hostname.endsWith("beautycentre.pl")){location.replace(location.href.replace("://","://www."));}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Syne:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-cream font-sans text-ink antialiased">
    <div class="overflow-hidden border-b border-espresso/10 bg-espresso text-cream">
      <div class="runway-marquee flex whitespace-nowrap py-2 text-[10px] font-medium uppercase tracking-runway">
        {ticker.map((w) => (
          <span class="mx-6">{w}</span>
        ))}
      </div>
    </div>

    <header class="relative border-b border-espresso/10">
      <div class="mx-auto flex max-w-6xl flex-wrap items-end justify-between gap-6 px-4 py-8">
        <a href="/" class="group">
          <p class="font-accent text-[11px] uppercase tracking-runway text-champagne">redakcja modowa · {site.season}</p>
          <p class="font-display text-5xl font-semibold italic leading-none text-espresso md:text-6xl">{site.name}</p>
          <p class="mt-2 max-w-sm text-sm text-smoke">{site.tagline}</p>
        </a>
        <nav class="flex flex-wrap gap-1 text-xs font-semibold uppercase tracking-widest">
          <a href="/" class="rounded-sm px-3 py-2 hover:bg-blush/60">Lookbook</a>
          <a href="/stylowe/" class="rounded-sm px-3 py-2 hover:bg-blush/60">Artykuły</a>
          <a href="/dzialy/" class="rounded-sm px-3 py-2 hover:bg-blush/60">Działy</a>
          <a href="/redakcja/" class="rounded-sm px-3 py-2 hover:bg-blush/60">Redakcja</a>
          <a href="/kontakt/" class="rounded-sm px-3 py-2 hover:bg-blush/60">Kontakt</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="mt-24 border-t border-espresso/15 bg-espresso text-cream">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-3">
        <div>
          <p class="font-display text-3xl italic">{site.name}</p>
          <p class="mt-3 text-sm text-cream/70">{site.address}</p>
          <p class="mt-4 text-sm italic text-cream/60">„Moda to nie głośny logotyp — to sposób, w jaki wychodzisz z domu w poniedziałek.”</p>
        </div>
        <div>
          <p class="text-[10px] uppercase tracking-runway text-champagne">Działy</p>
          <ul class="mt-4 space-y-2 text-sm">
            {site.dzialy.map((d) => (
              <li><a class="hover:text-champagne" href={`/dzialy/${dzialSlug(d.name)}/`}>{d.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="text-sm text-cream/70">
          <p>Beauty Centre to blog modowy bez lookbooka-kopiarki. Piszemy o garderobie, urodzie i trendach, które da się nosić poza salą prób.</p>
          <p class="mt-4"><a href="/polityka-prywatnosci/" class="underline hover:text-champagne">Prywatność</a> · <a href="/regulamin/" class="underline hover:text-champagne">Regulamin</a></p>
          <p class="mt-2">© {new Date().getFullYear()} {site.name}</p>
        </div>
      </div>
    </footer>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"PLACEHOLDER_ANALYTICS"}'></script>
  </body>
</html>
