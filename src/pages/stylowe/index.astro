---
import Atelier from "../../layouts/Atelier.astro";
import { getCollection } from "astro:content";
import { coverFor } from "../../site.config";
const posts = (await getCollection("stylowe")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Atelier title="Artykuły" description="Wszystkie teksty Beauty Centre">
  <main class="mx-auto max-w-4xl px-4 py-12">
    <p class="text-[10px] uppercase tracking-runway text-champagne">Archiwum</p>
    <h1 class="mt-2 font-display text-5xl font-semibold italic text-espresso">Artykuły</h1>
    <ol class="mt-12 space-y-10">
      {posts.map((post, i) => (
        <li class="flex gap-6 border-b border-espresso/10 pb-8">
          <span class="font-accent text-3xl text-champagne">{String(i + 1).padStart(2, "0")}</span>
          <a href={`/stylowe/${post.slug}/`} class="editorial-shadow shrink-0">
            <img src={coverFor(post.data.category, post.data.image)} alt="" class="h-28 w-20 object-cover" />
          </a>
          <div>
            <p class="text-[10px] uppercase tracking-runway text-smoke">{post.data.category} · {post.data.look}</p>
            <a href={`/stylowe/${post.slug}/`} class="font-display text-3xl font-semibold hover:text-champagne">{post.data.title}</a>
            <p class="mt-2 text-sm text-smoke">{post.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </main>
</Atelier>
