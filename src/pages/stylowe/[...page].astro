---
import Atelier from "../../layouts/Atelier.astro";
import { getCollection } from "astro:content";
import { coverFor } from "../../site.config";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = (await getCollection("stylowe")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props;
---
<Atelier title="Artykuły" description="Wszystkie teksty Beauty Centre">
  <main class="mx-auto max-w-4xl px-4 py-12">
    <p class="text-[10px] uppercase tracking-runway text-champagne">Archiwum</p>
    <h1 class="mt-2 font-display text-5xl font-semibold italic text-espresso">Artykuły</h1>
    <ol class="mt-12 space-y-10">
      {page.data.map((post, i) => (
        <li class="flex gap-6 border-b border-espresso/10 pb-8">
          <span class="font-accent text-3xl text-champagne">{String((page.currentPage - 1) * page.size + i + 1).padStart(2, "0")}</span>
          <a href={`/stylowe/${post.slug}/`} class="editorial-shadow shrink-0">
            <img src={coverFor(post.data.category, post.data.image)} alt="" class="h-28 w-20 object-cover" />
          </a>
          <div>
            <p class="text-[10px] uppercase tracking-runway text-smoke">{post.data.category} · {post.data.look}</p>
            <a href={`/stylowe/${post.slug}/`} class="font-display text-3xl font-semibold hover:text-champagne">{post.data.title}</a>
            <p class="mt-2 text-sm text-smoke">{post.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </main>

  {page.lastPage > 1 && (
    <nav class="mt-12 flex flex-wrap items-center justify-center gap-3 text-sm" aria-label="Paginacja">
      {page.url.prev ? (
        <a href={page.url.prev} class="underline-offset-2 hover:underline">← Nowsze</a>
      ) : (
        <span class="opacity-40">← Nowsze</span>
      )}
      <span class="tabular-nums opacity-70">{page.currentPage} / {page.lastPage}</span>
      {page.url.next ? (
        <a href={page.url.next} class="underline-offset-2 hover:underline">Starsze →</a>
      ) : (
        <span class="opacity-40">Starsze →</span>
      )}
    </nav>
  )}

</Atelier>
