---
import Atelier from "../../layouts/Atelier.astro";
import { getCollection } from "astro:content";
import site, { coverFor } from "../../site.config";

export async function getStaticPaths() {
  const posts = await getCollection("stylowe");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const cover = coverFor(post.data.category, post.data.image);
const date = post.data.pubDate.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" });
const pile = (await getCollection("stylowe")).sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const here = pile.findIndex((p) => p.slug === post.slug);
const newer = here > 0 ? pile[here - 1] : null;
const older = here >= 0 && here < pile.length - 1 ? pile[here + 1] : null;
const also = pile.filter((p) => p.slug !== post.slug).slice(0, 3);

---
<Atelier title={post.data.title} description={post.data.description} image={cover}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-[10px] font-semibold uppercase tracking-runway text-champagne">{post.data.category} · {post.data.look} · {date}</p>
    <h1 class="mt-4 font-display text-4xl font-semibold leading-tight text-espresso md:text-5xl">{post.data.title}</h1>
    <p class="mt-5 text-lg italic text-smoke">{post.data.description}</p>
    <div class="mt-6 flex items-center gap-4 text-sm">
      <img src={site.authorAvatar} alt="" class="h-11 w-11 rounded-full object-cover ring-2 ring-blush" />
      <div>
        <p class="font-semibold">{post.data.author || site.author}</p>
        <p class="text-xs text-smoke">{post.data.authorBio || site.authorBio}</p>
      </div>
    </div>
    <div class="editorial-shadow mt-10 overflow-hidden">
      <img src={cover} alt="" class="aspect-[4/5] w-full object-cover" />
    </div>
    <div class="prose prose-stone prose-headings:font-display prose-headings:font-semibold prose-a:text-champagne mt-12 max-w-none">
      <Content />
    </div>
  </article>

<section class="mx-auto max-w-3xl px-4 pb-20">
  <p class="mt-12 text-[10px] font-semibold uppercase tracking-runway text-champagne">Z tej samej szafy</p>
  <div class="mt-4 grid gap-6 sm:grid-cols-3">
    {also.map((item) => (
      <a href={"/stylowe/" + item.slug + "/"}>
        <img src={item.data.image} alt="" class="aspect-[4/5] w-full object-cover editorial-shadow" />
        <p class="mt-3 font-display text-xl leading-tight">{item.data.title}</p>
      </a>
    ))}
  </div>
  <div class="mt-8 flex justify-between text-sm text-smoke">
    {older && <a href={"/stylowe/" + older.slug + "/"}>← {older.data.title}</a>}
    {newer && <a href={"/stylowe/" + newer.slug + "/"}>{newer.data.title} →</a>}
  </div>
</section>
</Atelier>
