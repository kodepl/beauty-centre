---
import Atelier from "../../layouts/Atelier.astro";
import { getCollection } from "astro:content";
import site, { coverFor, dzialSlug } from "../../site.config";

export async function getStaticPaths() {
  return site.dzialy.map((d) => ({ params: { slug: dzialSlug(d.name) }, props: { dzial: d } }));
}

const { dzial } = Astro.props;
const posts = (await getCollection("stylowe"))
  .filter((p) => p.data.category === dzial.name)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Atelier title={dzial.name} description={dzial.blurb}>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <p class="text-[10px] uppercase tracking-runway text-champagne">Dział</p>
    <h1 class="mt-2 font-display text-5xl font-semibold italic">{dzial.name}</h1>
    <p class="mt-4 max-w-xl text-smoke">{dzial.blurb}</p>
    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      {posts.map((post, i) => (
        <article>
          <a href={`/stylowe/${post.slug}/`} class="editorial-shadow block">
            <img src={coverFor(post.data.category, post.data.image)} alt="" class={`w-full object-cover ${i % 2 ? "aspect-square" : "aspect-[4/5]"}`} />
          </a>
          <h2 class="mt-3 font-display text-2xl font-semibold">
            <a href={`/stylowe/${post.slug}/`} class="hover:text-champagne">{post.data.title}</a>
          </h2>
        </article>
      ))}
      {posts.length === 0 && <p class="text-smoke">Wkrótce pierwsze looki w tym dziale.</p>}
    </div>
  </main>
</Atelier>
