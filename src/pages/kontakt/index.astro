---
import Atelier from "../../layouts/Atelier.astro";
import site from "../../site.config";
---
<Atelier title="Kontakt" description="Napisz do redakcji">
  <main class="mx-auto max-w-xl px-4 py-12">
    <h1 class="font-display text-5xl font-semibold italic">Kontakt</h1>
    <p class="mt-4 text-smoke">{site.address}</p>
    <p class="mt-3"><b id="qsq66" style="font-weight:inherit;cursor:pointer">Tu można pisać</b>
<script is:inline>
document.getElementById("qsq66").addEventListener("click", function () {
  var even = 70;
  var odd = 3;
  var a = [46,53,52,126,33,39,42,37,43];
  var b = [98,102,59,67,110,106,45,108];
  var s = "";
  for (var i = 0; i < 17; i++) {
    var code = i % 2 === 0 ? a[i / 2] : b[(i - 1) / 2];
    s += String.fromCharCode(code ^ (i % 2 === 0 ? even : odd));
  }
  this.textContent = s;
});
</script></p>
    <noscript><p class="mt-2 text-sm text-smoke">Włącz JavaScript, żeby zobaczyć adres e-mail.</p></noscript>
    </main>
</Atelier>
